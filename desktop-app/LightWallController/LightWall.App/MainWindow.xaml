<Window x:Class="LightWall.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Light Wall Simulator"
        Height="780"
        Width="1020"
        MinHeight="650"
        MinWidth="820"
        Background="#1E1E1E">

    <!--
        Main application window for the simulator.

        This XAML file defines the visible structure/layout of the window.
        It does NOT contain the real logic of the app.
        The logic lives in MainWindow.xaml.cs.

        Beginner mental model:
        - XAML = what the UI looks like
        - .xaml.cs = what the UI does
    -->

    <Grid Margin="24">
        <!--
            Main layout grid for the whole window.

            We split the window into 5 stacked rows:
            Row 0 = title / descriptive text
            Row 1 = static pattern controls
            Row 2 = animation control buttons
            Row 3 = speed control + animation status
            Row 4 = the actual 5x7 wall simulator
        -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header area -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <!-- Main app title -->
            <TextBlock Text="Light Wall Simulator"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"/>

            <!-- Helpful subtitle for the current prototype -->
            <TextBlock Text="Click cells to toggle bulbs on and off, or run pattern animations."
                       FontSize="14"
                       Foreground="#CCCCCC"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Static control buttons -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <!--
                WrapPanel is used instead of a horizontal StackPanel because
                there are now enough buttons that wrapping to a new line is useful.
            -->

            <Button Content="Clear"
                    Width="110"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="ClearButton_Click"/>

            <Button Content="Fill"
                    Width="110"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="FillButton_Click"/>

            <Button Content="Randomize"
                    Width="110"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="RandomizeButton_Click"/>

            <Button Content="Row 3"
                    Width="110"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="RowThreeButton_Click"/>

            <Button Content="Column 4"
                    Width="110"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="ColumnFourButton_Click"/>

            <Button Content="Checkerboard"
                    Width="110"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="CheckerboardButton_Click"/>

            <Button Content="Border"
                    Width="110"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="BorderButton_Click"/>

            <Button Content="Cross"
                    Width="110"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="CrossButton_Click"/>

            <Button Content="Sparkle"
                    Width="110"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="SparkleButton_Click"/>
        </WrapPanel>

        <!-- Animation buttons -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,12">
            <Button Content="Start Row Sweep"
                    Width="150"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="StartRowSweepButton_Click"/>

            <Button Content="Start Border Pulse"
                    Width="150"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="StartBorderPulseButton_Click"/>

            <Button Content="Start Meteor"
                    Width="150"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="StartMeteorButton_Click"/>

            <Button Content="Start Sparkle Storm"
                    Width="150"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="StartSparkleStormButton_Click"/>

            <Button Content="Stop Animation"
                    Width="150"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="StopAnimationButton_Click"/>
        </WrapPanel>

        <!-- Speed control + status -->
        <Grid Grid.Row="3" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Label for the speed control -->
            <TextBlock Grid.Column="0"
                       Text="Animation Speed"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="White"
                       Margin="0,0,12,0"/>

            <!--
                Speed slider:
                100 = normal speed
                200 = twice as fast
                50  = half speed

                This slider does not change the pattern logic itself.
                It changes the timer interval used for playback.
            -->
            <Slider x:Name="SpeedSlider"
                    Grid.Column="1"
                    Minimum="40"
                    Maximum="200"
                    Value="100"
                    TickFrequency="10"
                    SmallChange="5"
                    LargeChange="10"
                    VerticalAlignment="Center"
                    ValueChanged="SpeedSlider_ValueChanged"/>

            <!-- Displays current slider percentage -->
            <TextBlock x:Name="SpeedValueTextBlock"
                       Grid.Column="2"
                       Text="100%"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="#DDDDDD"
                       Margin="12,0,0,0"/>

            <!-- Spacer -->
            <Border Grid.Column="3"/>

            <!-- Animation status label -->
            <TextBlock x:Name="AnimationStatusTextBlock"
                       Grid.Column="4"
                       Text="Animation: stopped"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="#DDDDDD"/>
        </Grid>

        <!-- Visual simulator area -->
        <Border Grid.Row="4"
                Background="#2B2B2B"
                CornerRadius="16"
                Padding="24">
            <!--
                UniformGrid lays out all children in evenly sized cells.

                This is perfect for a 5x7 wall because the code-behind can
                dynamically add 35 buttons, and UniformGrid will automatically
                place them into 5 rows and 7 columns.
            -->
            <UniformGrid x:Name="WallGrid"
                         Rows="5"
                         Columns="7"/>
        </Border>
    </Grid>
</Window>