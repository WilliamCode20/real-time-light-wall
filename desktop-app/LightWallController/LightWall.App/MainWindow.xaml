<Window x:Class="LightWall.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Light Wall Simulator"
        Height="720"
        Width="1000"
        MinHeight="600"
        MinWidth="800"
        Background="#1E1E1E">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Light Wall Simulator"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="Click cells to toggle bulbs on and off, or run pattern animations."
                       FontSize="14"
                       Foreground="#CCCCCC"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Content="Clear"
                    Width="110"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="ClearButton_Click"/>

            <Button Content="Fill"
                    Width="110"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="FillButton_Click"/>

            <Button Content="Randomize"
                    Width="110"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="RandomizeButton_Click"/>

            <Button Content="Row 3"
                    Width="110"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="RowThreeButton_Click"/>

            <Button Content="Column 4"
                    Width="110"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="ColumnFourButton_Click"/>

            <Button Content="Checkerboard"
                    Width="110"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="CheckerboardButton_Click"/>

            <Button Content="Border"
                    Width="110"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="BorderButton_Click"/>

            <Button Content="Cross"
                    Width="110"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="CrossButton_Click"/>

            <Button Content="Sparkle"
                    Width="110"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="SparkleButton_Click"/>
        </WrapPanel>

        <WrapPanel Grid.Row="2" Margin="0,0,0,20">
            <Button Content="Start Row Sweep"
                    Width="140"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="StartRowSweepButton_Click"/>

            <Button Content="Start Border Pulse"
                    Width="140"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="StartBorderPulseButton_Click"/>

            <Button Content="Stop Animation"
                    Width="140"
                    Height="36"
                    Margin="0,0,12,12"
                    Click="StopAnimationButton_Click"/>

            <TextBlock x:Name="AnimationStatusTextBlock"
                       Text="Animation: stopped"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="#DDDDDD"
                       Margin="12,8,0,0"/>
        </WrapPanel>

        <Border Grid.Row="3"
                Background="#2B2B2B"
                CornerRadius="16"
                Padding="24">
            <UniformGrid x:Name="WallGrid"
                         Rows="5"
                         Columns="7"/>
        </Border>
    </Grid>
</Window>