<Window x:Class="LightWall.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Light Wall Simulator"
        Height="820"
        Width="1240"
        MinHeight="600"
        MinWidth="900"
        Background="#1E1E1E">

    <!--
        Main application window for the simulator.

        This XAML file defines the visible structure/layout of the window.
        It does NOT contain the real logic of the app.
        The logic lives in MainWindow.xaml.cs.

        Mental model:
        - XAML     = what the UI looks like
        - .xaml.cs = what the UI does

        WHY THE LAYOUT IS TWO COLUMNS

        Everything used to be stacked vertically, with the wall at the bottom.
        The controls grew tall enough that the wall was pushed off the bottom of
        the screen entirely at any sensible window height.

        Controls on the left and the wall on the right fixes that, and is a
        better use of the space anyway: a widescreen monitor has horizontal room
        to spare and very little vertical room. It also gives the wall the
        prominence it should have, since it is the thing being looked at.

        WHY THERE ARE ALMOST NO BUTTONS WRITTEN HERE

        The effect buttons used to be listed out one by one in this file, which
        meant adding an effect required editing three places.

        The three WrapPanels below are left empty on purpose and filled in by the
        code-behind, which asks EffectCatalog what effects exist and makes a
        button for each. Adding an effect to the catalog makes it appear here
        automatically.
    -->

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <!-- Left: all the controls, in a scrollable panel. -->
            <ColumnDefinition Width="540"/>
            <!-- Right: the wall itself, taking whatever space is left. -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--
            The controls sit inside a ScrollViewer so that shrinking the window
            makes them scroll rather than getting cut off and becoming
            unreachable.
        -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,24,0">
            <StackPanel>

                <!-- Header area -->
                <TextBlock Text="Light Wall Simulator"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Click cells to toggle bulbs by hand, or choose a pattern or animation. Hover a button to see what it does."
                           FontSize="13"
                           Foreground="#CCCCCC"
                           TextWrapping="Wrap"
                           Margin="0,6,0,16"/>

                <!-- Static patterns section -->
                <TextBlock Text="Static Patterns"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,8"/>

                <!-- Filled in by BuildEffectButtons() in the code-behind. -->
                <WrapPanel x:Name="StaticPatternsPanel" Margin="0,0,0,6"/>

                <!-- Pre-set animations section -->
                <TextBlock Text="Pre-Set Animations"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,8,0,8"/>

                <!-- Filled in by BuildEffectButtons() in the code-behind. -->
                <WrapPanel x:Name="SequenceAnimationsPanel" Margin="0,0,0,6"/>

                <!-- Procedural animations section -->
                <TextBlock Text="Procedural Animations"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,8,0,8"/>

                <!-- Filled in by BuildEffectButtons() in the code-behind. -->
                <WrapPanel x:Name="ProceduralAnimationsPanel" Margin="0,0,0,6"/>

                <!--
                    Stop is written out by hand rather than generated, because it
                    is not an effect. It switches the engine into manual mode,
                    leaving whatever frame was showing frozen on the wall.
                -->
                <Button Content="Stop Animation"
                        Width="150"
                        Height="34"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,14"
                        ToolTip="Stops the running effect and freezes the wall on its current frame."
                        Click="StopAnimationButton_Click"/>

                <!-- Animation controls -->
                <TextBlock Text="Animation Controls"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <!-- Speed -->
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Speed"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,0,12,10"/>

                    <Slider x:Name="SpeedSlider"
                            Grid.Row="0"
                            Grid.Column="1"
                            Minimum="10"
                            Maximum="300"
                            Value="100"
                            TickFrequency="10"
                            SmallChange="5"
                            LargeChange="10"
                            VerticalAlignment="Center"
                            Margin="0,0,0,10"
                            ToolTip="How fast effects play. 100% is their designed speed."
                            ValueChanged="SpeedSlider_ValueChanged"/>

                    <TextBlock x:Name="SpeedValueTextBlock"
                               Grid.Row="0"
                               Grid.Column="2"
                               Text="100%"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#DDDDDD"
                               Margin="12,0,0,10"/>

                    <!-- Center X -->
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Center X"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,0,12,10"/>

                    <Slider x:Name="CenterXSlider"
                            Grid.Row="1"
                            Grid.Column="1"
                            Minimum="-3"
                            Maximum="3"
                            Value="0"
                            TickFrequency="1"
                            SmallChange="1"
                            LargeChange="1"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            Margin="0,0,0,10"
                            ToolTip="Shifts the picture left or right. Content pushed off the edge is discarded."
                            ValueChanged="CenterSlider_ValueChanged"/>

                    <TextBlock x:Name="CenterXValueTextBlock"
                               Grid.Row="1"
                               Grid.Column="2"
                               Text="0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#DDDDDD"
                               Margin="12,0,0,10"/>

                    <!-- Center Y -->
                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Center Y"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,0,12,10"/>

                    <Slider x:Name="CenterYSlider"
                            Grid.Row="2"
                            Grid.Column="1"
                            Minimum="-2"
                            Maximum="2"
                            Value="0"
                            TickFrequency="1"
                            SmallChange="1"
                            LargeChange="1"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            Margin="0,0,0,10"
                            ToolTip="Shifts the picture up or down. Content pushed off the edge is discarded."
                            ValueChanged="CenterSlider_ValueChanged"/>

                    <TextBlock x:Name="CenterYValueTextBlock"
                               Grid.Row="2"
                               Grid.Column="2"
                               Text="0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#DDDDDD"
                               Margin="12,0,0,10"/>

                    <!-- Meteor Tail Length -->
                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="Meteor Tail"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,0,12,0"/>

                    <Slider x:Name="MeteorTailLengthSlider"
                            Grid.Row="3"
                            Grid.Column="1"
                            Minimum="1"
                            Maximum="5"
                            Value="3"
                            TickFrequency="1"
                            SmallChange="1"
                            LargeChange="1"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ToolTip="How long the Meteor effect's trail is. Only affects Meteor."
                            ValueChanged="MeteorTailLengthSlider_ValueChanged"/>

                    <TextBlock x:Name="MeteorTailLengthValueTextBlock"
                               Grid.Row="3"
                               Grid.Column="2"
                               Text="3"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#DDDDDD"
                               Margin="12,0,0,0"/>
                </Grid>

                <!--
                    Audio capture.

                    Listens to what this computer is PLAYING, not to a
                    microphone. That means it hears the music exactly as mixed,
                    with no room echo and no people talking, whatever program is
                    producing the sound.

                    The EQ Bumper effect follows this level. Start listening and
                    the wall tracks the music; stop the music and it falls dark.
                    Without capture running, EQ Bumper drops back to a test
                    pattern so it still shows something in the simulator.
                -->
                <TextBlock Text="Audio Capture"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,4"/>

                <TextBlock Text="Listens to what this computer is playing. Start it, then run EQ Bumper to see the wall follow the music."
                           FontSize="12"
                           Foreground="#999999"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <WrapPanel Margin="0,0,0,10">
                    <Button x:Name="AudioStartButton"
                            Content="Start Listening"
                            Width="130"
                            Height="30"
                            Margin="0,0,10,0"
                            ToolTip="Begin capturing whatever this computer is playing."
                            Click="AudioStartButton_Click"/>

                    <Button x:Name="AudioStopButton"
                            Content="Stop"
                            Width="80"
                            Height="30"
                            IsEnabled="False"
                            Click="AudioStopButton_Click"/>
                </WrapPanel>

                <!--
                    The level meter.

                    Two bars: the smoothed level that will eventually drive
                    visuals, and the raw peak underneath it for comparison.

                    Seeing both together is the useful part. The peak bar jumps
                    around violently while the level bar moves the way a light
                    should - which is the clearest demonstration of why the
                    smoothing exists.
                -->
                <Grid Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Level"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="White"
                               Margin="0,0,10,6"/>

                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Height="22"
                            Background="#1A1A1A"
                            BorderBrush="#444444"
                            BorderThickness="1"
                            Margin="0,0,0,6">
                        <!--
                            The bar is drawn by a Rectangle pinned to the left
                            whose width the code-behind sets each frame.
                        -->
                        <Rectangle x:Name="AudioLevelBar"
                                   HorizontalAlignment="Left"
                                   Fill="#FFC700"
                                   Width="0"/>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Peak"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="White"
                               Margin="0,0,10,0"/>

                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Height="12"
                            Background="#1A1A1A"
                            BorderBrush="#444444"
                            BorderThickness="1">
                        <Rectangle x:Name="AudioPeakBar"
                                   HorizontalAlignment="Left"
                                   Fill="#6699FF"
                                   Width="0"/>
                    </Border>
                </Grid>

                <!--
                    Sensitivity.

                    The wall already adjusts itself to the system volume, so this
                    is for taste rather than for correction: how hard the bars
                    should bump for a given piece of music.
                -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Sensitivity"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,0,12,0"/>

                    <Slider x:Name="AudioSensitivitySlider"
                            Grid.Column="1"
                            Minimum="0.5"
                            Maximum="3"
                            Value="1"
                            TickFrequency="0.1"
                            SmallChange="0.1"
                            LargeChange="0.25"
                            VerticalAlignment="Center"
                            ToolTip="How hard the bars bump. The wall already compensates for the system volume, so this is for taste."
                            ValueChanged="AudioSensitivitySlider_ValueChanged"/>

                    <TextBlock x:Name="AudioSensitivityValueTextBlock"
                               Grid.Column="2"
                               Text="1.0x"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#DDDDDD"
                               Margin="12,0,0,0"/>
                </Grid>

                <!--
                    Smoothing.

                    Adjusts two things at once, because they are two halves of
                    the same idea: how long a bar takes to fall back after a hit
                    (smoothing each column over time), and how much neighbouring
                    bands blend into each other (smoothing the top edge across
                    the wall).

                    The second is what gives an equaliser its familiar rolling
                    curve rather than seven columns jumping about independently.

                    Rising is deliberately never slowed. However smooth the wall
                    should look, a drum hit should land the moment it happens.
                -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Smoothing"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,0,12,0"/>

                    <Slider x:Name="AudioSmoothingSlider"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="1"
                            Value="0.5"
                            TickFrequency="0.05"
                            SmallChange="0.05"
                            LargeChange="0.1"
                            VerticalAlignment="Center"
                            ToolTip="Low is raw and twitchy; high is slow and flowing. Drum hits still land instantly either way."
                            ValueChanged="AudioSmoothingSlider_ValueChanged"/>

                    <TextBlock x:Name="AudioSmoothingValueTextBlock"
                               Grid.Column="2"
                               Text="0.50"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#DDDDDD"
                               Margin="12,0,0,0"/>
                </Grid>

                <!--
                    Beat detection.

                    These two settings decide what counts as a beat. Both have
                    to be set by ear, because the right answer depends on the
                    music - so they are sliders rather than numbers buried in
                    the code, and there is a meter below showing what they are
                    doing.

                    Pick an effect that reacts to beats (Beat Flash is the
                    plainest) and adjust while something is playing.
                -->
                <TextBlock Text="Beat detection"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,6,0,8"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Beat size"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,0,12,0"/>

                    <Slider x:Name="BeatSensitivitySlider"
                            Grid.Column="1"
                            Minimum="1"
                            Maximum="3"
                            Value="1.4"
                            TickFrequency="0.05"
                            SmallChange="0.05"
                            LargeChange="0.1"
                            VerticalAlignment="Center"
                            ToolTip="How big a jump has to be to count as a beat. Flashing too often means raise it; missing obvious hits means lower it."
                            ValueChanged="BeatSensitivitySlider_ValueChanged"/>

                    <TextBlock x:Name="BeatSensitivityValueTextBlock"
                               Grid.Column="2"
                               Text="1.40x"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#DDDDDD"
                               Margin="12,0,0,0"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Beat gap"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,0,12,0"/>

                    <Slider x:Name="BeatGapSlider"
                            Grid.Column="1"
                            Minimum="0.05"
                            Maximum="0.3"
                            Value="0.12"
                            TickFrequency="0.01"
                            SmallChange="0.01"
                            LargeChange="0.02"
                            VerticalAlignment="Center"
                            ToolTip="The shortest gap allowed between two beats. Raise it if one drum hit is being counted twice."
                            ValueChanged="BeatGapSlider_ValueChanged"/>

                    <TextBlock x:Name="BeatGapValueTextBlock"
                               Grid.Column="2"
                               Text="0.12s"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#DDDDDD"
                               Margin="12,0,0,0"/>
                </Grid>

                <!--
                    The trigger meter.

                    The bar is how close the sound is right now to being counted
                    as a beat, and the red line is the point it has to reach.
                    Bar short of the line means nothing is being detected; bar
                    permanently past it means the setting is too low.

                    The lamp on the right lights when a beat is actually
                    reported. It is separate from the bar on purpose: reaching
                    the line is necessary but not sufficient, because a beat also
                    has to be on the way up and far enough after the last one.
                    Watching both together is what tells you which of those is
                    getting in the way.
                -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Trigger"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="White"
                               Margin="0,0,10,0"/>

                    <Border Grid.Column="1"
                            Height="22"
                            Background="#1A1A1A"
                            BorderBrush="#444444"
                            BorderThickness="1">
                        <!--
                            The two columns exist only to place the red line at a
                            fixed fraction of the width - 2 parts to 3 puts it
                            two fifths of the way across. Doing it with column
                            widths rather than from code means it stays put when
                            the window is resized, with nothing to keep in step.

                            The bar spans both columns so it can grow past the
                            line. Full width is two and a half times the trigger
                            point, which is far enough to see a big hit without
                            squashing normal readings into nothing.
                        -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <Rectangle x:Name="BeatTriggerBar"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       HorizontalAlignment="Left"
                                       Fill="#44DD88"
                                       Width="0"/>

                            <Rectangle Grid.Column="1"
                                       HorizontalAlignment="Left"
                                       Width="2"
                                       Fill="#FF5555"/>
                        </Grid>
                    </Border>

                    <Border x:Name="BeatLamp"
                            Grid.Column="2"
                            Width="22"
                            Height="22"
                            CornerRadius="11"
                            Margin="10,0,0,0"
                            Background="#2A2A2A"
                            BorderBrush="#444444"
                            BorderThickness="1"
                            ToolTip="Lights on every detected beat."/>
                </Grid>

                <Border Background="#232323"
                        BorderBrush="#444444"
                        BorderThickness="1"
                        Padding="10,8"
                        Margin="0,0,0,16">
                    <TextBlock x:Name="AudioStatusTextBlock"
                               Text="Not listening"
                               FontSize="12"
                               FontFamily="Consolas"
                               Foreground="#999999"
                               TextWrapping="Wrap"/>
                </Border>

                <!--
                    Serial connection.

                    Chooses which wall is being driven. The virtual wall runs
                    always; connecting a port adds the real one alongside it
                    rather than replacing it, so both stay visible.

                    That matters when something looks wrong on the physical wall:
                    if the virtual wall shows the same thing, the fault is
                    upstream in the app; if the virtual wall looks right, the
                    fault is in the cable, the firmware or the wiring.
                -->
                <TextBlock Text="Arduino Connection"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,4"/>

                <TextBlock Text="The virtual wall always runs. Connecting a port drives the real wall as well."
                           FontSize="12"
                           Foreground="#999999"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <WrapPanel Margin="0,0,0,8">
                    <ComboBox x:Name="SerialPortComboBox"
                              Width="150"
                              Height="30"
                              Margin="0,0,10,8"
                              ToolTip="Serial ports found on this computer. The Arduino is usually the highest-numbered one that appears when you plug it in."/>

                    <Button Content="Refresh"
                            Width="80"
                            Height="30"
                            Margin="0,0,10,8"
                            ToolTip="Look for ports again, after plugging the Arduino in."
                            Click="RefreshPortsButton_Click"/>

                    <Button x:Name="ConnectButton"
                            Content="Connect"
                            Width="100"
                            Height="30"
                            Margin="0,0,10,8"
                            ToolTip="Open the selected port and start driving the real wall."
                            Click="ConnectButton_Click"/>

                    <Button x:Name="DisconnectButton"
                            Content="Disconnect"
                            Width="100"
                            Height="30"
                            Margin="0,0,10,8"
                            IsEnabled="False"
                            ToolTip="Close the port. The wall is blanked first rather than being left frozen."
                            Click="DisconnectButton_Click"/>
                </WrapPanel>

                <!--
                    Connection status.

                    The "waiting for board" state matters more than it looks.
                    Opening a serial port resets the Arduino, and its bootloader
                    swallows everything for about two seconds afterwards. Without
                    something saying so, those two seconds are indistinguishable
                    from a completely dead connection.
                -->
                <Border Background="#232323"
                        BorderBrush="#444444"
                        BorderThickness="1"
                        Padding="10,8"
                        Margin="0,0,0,16">
                    <TextBlock x:Name="SerialStatusTextBlock"
                               Text="Not connected — virtual wall only"
                               FontSize="12"
                               FontFamily="Consolas"
                               Foreground="#999999"
                               TextWrapping="Wrap"/>
                </Border>

                <!--
                    Hardware check.

                    Lights one bulb at a time so the wiring can be confirmed
                    against the relay labels in the enclosure.

                    This answers the one question that cannot be settled at a
                    desk: whether relay A1 really does switch the top-left bulb.
                    The app and the firmware will agree perfectly with each other
                    while both being wrong about the physical wall, and only
                    looking at it can tell.

                    Stepping is manual on purpose. An automatic sweep would move
                    on while you were still walking round to look at the wall.
                -->
                <TextBlock Text="Hardware Check"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,4"/>

                <TextBlock Text="Lights one bulb at a time, so the wiring can be checked against the relay labels."
                           FontSize="12"
                           Foreground="#999999"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <!--
                    The readout naming the current bulb every way at once: its
                    number, its position, the sticker on its relay, and the
                    Arduino pin. Having all four visible means a reading can be
                    checked against the wall and against the relay that just
                    clicked without doing arithmetic on a ladder.
                -->
                <Border Background="#232323"
                        BorderBrush="#444444"
                        BorderThickness="1"
                        Padding="10,8"
                        Margin="0,0,0,10">
                    <TextBlock x:Name="IdentifyReadoutTextBlock"
                               Text="Not running"
                               FontFamily="Consolas"
                               FontSize="13"
                               Foreground="#FFC700"
                               TextWrapping="Wrap"/>
                </Border>

                <WrapPanel Margin="0,0,0,10">
                    <Button Content="Start Check"
                            Width="110"
                            Height="32"
                            Margin="0,0,10,8"
                            ToolTip="Lights a single bulb and holds it, so the wiring can be checked."
                            Click="IdentifyStartButton_Click"/>

                    <Button Content="◀ Previous"
                            Width="100"
                            Height="32"
                            Margin="0,0,10,8"
                            ToolTip="Step back one bulb."
                            Click="IdentifyPreviousButton_Click"/>

                    <Button Content="Next ▶"
                            Width="100"
                            Height="32"
                            Margin="0,0,10,8"
                            ToolTip="Step forward one bulb."
                            Click="IdentifyNextButton_Click"/>
                </WrapPanel>

                <!--
                    Jumping straight to a relay label. Faster than stepping
                    through 35 when spot-checking a single suspicious bulb, and
                    it lets you work from the sticker rather than from a number.
                -->
                <WrapPanel Margin="0,0,0,16">
                    <TextBlock Text="Go to relay"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,0,10,0"/>

                    <TextBox x:Name="IdentifyLabelTextBox"
                             Width="70"
                             Height="28"
                             VerticalContentAlignment="Center"
                             Padding="6,0"
                             Background="#232323"
                             Foreground="#DDDDDD"
                             BorderBrush="#444444"
                             FontFamily="Consolas"
                             ToolTip="Type a relay label such as C4, then press Enter or Go."
                             KeyDown="IdentifyLabelTextBox_KeyDown"/>

                    <Button Content="Go"
                            Width="60"
                            Height="28"
                            Margin="10,0,0,0"
                            Click="IdentifyGoButton_Click"/>
                </WrapPanel>

                <!--
                    Fault injection.

                    These deliberately damage the byte stream on its way to the
                    virtual wall, imitating a noisy or failing cable.

                    This is not a toy. A real cable will occasionally lose or
                    mangle a byte, and the question that matters is not whether
                    that happens but whether everything downstream recovers when
                    it does. Making a real cable misbehave on demand is very
                    difficult. Here it is a slider.

                    Turn either up and watch the bottom wall start lagging behind
                    the top one as damaged packets are thrown away, then catch
                    up. The statistics underneath it count what happened.
                -->
                <TextBlock Text="Virtual Wall Faults"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,4"/>

                <TextBlock Text="Damages the byte stream on purpose, to prove the receiver recovers."
                           FontSize="12"
                           Foreground="#999999"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Drop bytes"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,0,12,10"/>

                    <Slider x:Name="ByteDropSlider"
                            Grid.Row="0"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="5"
                            Value="0"
                            TickFrequency="0.5"
                            SmallChange="0.1"
                            LargeChange="0.5"
                            VerticalAlignment="Center"
                            Margin="0,0,0,10"
                            ToolTip="Chance of each byte vanishing. The nastiest fault, because it shifts everything after it out of position."
                            ValueChanged="FaultSlider_ValueChanged"/>

                    <TextBlock x:Name="ByteDropValueTextBlock"
                               Grid.Row="0"
                               Grid.Column="2"
                               Text="0.0%"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#DDDDDD"
                               Margin="12,0,0,10"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Corrupt bytes"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,0,12,0"/>

                    <Slider x:Name="ByteCorruptSlider"
                            Grid.Row="1"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="5"
                            Value="0"
                            TickFrequency="0.5"
                            SmallChange="0.1"
                            LargeChange="0.5"
                            VerticalAlignment="Center"
                            ToolTip="Chance of each byte arriving with one bit flipped. The checksum should catch these."
                            ValueChanged="FaultSlider_ValueChanged"/>

                    <TextBlock x:Name="ByteCorruptValueTextBlock"
                               Grid.Row="1"
                               Grid.Column="2"
                               Text="0.0%"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#DDDDDD"
                               Margin="12,0,0,0"/>
                </Grid>

                <!-- Serialized packet preview -->
                <TextBlock Text="Packet Preview"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,8"/>

                <!--
                    Read-only preview of the bytes that would go down the serial
                    cable for the frame currently on screen.

                    This is a development aid. It lets us confirm the wall state
                    is being packed as expected before any real hardware is
                    involved, and it will be the first thing to check when the
                    wall eventually shows something unexpected.
                -->
                <TextBox x:Name="SerializedPacketTextBox"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         MinHeight="60"
                         Padding="8"
                         Background="#232323"
                         Foreground="#DDDDDD"
                         BorderBrush="#444444"
                         FontFamily="Consolas"
                         FontSize="12"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Visual simulator area -->
        <Grid Grid.Column="1">
            <!--
                TWO WALLS, ONE ABOVE THE OTHER

                Top    - what the engine decided the wall should look like.
                Bottom - what a wall on the other end of the cable would
                         actually be showing, decoded from the packets we sent.

                In normal running these are identical, and that is the point:
                seeing them match while sliders are being dragged is the proof
                that the whole chain works - packing, transmission, framing,
                checksum validation and unpacking.

                They come apart when something goes wrong. Turn up the fault
                sliders and the bottom wall starts freezing on old frames as
                packets get thrown away, then catches up again. That is the real
                error handling being exercised, not a mock-up of it.
            -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Engine — what the wall should show"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="#AAAAAA"
                       Margin="4,0,0,6"/>

            <Border Grid.Row="1"
                    Background="#2B2B2B"
                    CornerRadius="16"
                    Padding="14">
                <!--
                    Viewbox scales whatever is inside it to fit the space while
                    keeping its proportions.

                    That is what keeps the wall looking like a 7-wide, 5-tall
                    wall at any window size. Without it, the grid would stretch
                    to fill whatever shape the window happened to be, and the
                    bulbs would become tall thin rectangles on a narrow window -
                    a misleading picture of a physical object we are trying to
                    represent faithfully.

                    The 700 x 500 size below is only a ratio. The Viewbox scales
                    it up or down to whatever actually fits.
                -->
                <Viewbox Stretch="Uniform">
                    <UniformGrid x:Name="WallGrid"
                                 Rows="5"
                                 Columns="7"
                                 Width="700"
                                 Height="500"/>
                </Viewbox>
            </Border>

            <TextBlock Grid.Row="2"
                       Text="Virtual wall — decoded from the packets sent"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="#AAAAAA"
                       Margin="4,14,0,6"/>

            <Border Grid.Row="3"
                    Background="#242424"
                    CornerRadius="16"
                    Padding="14">
                <Viewbox Stretch="Uniform">
                    <UniformGrid x:Name="VirtualWallGrid"
                                 Rows="5"
                                 Columns="7"
                                 Width="700"
                                 Height="500"/>
                </Viewbox>
            </Border>

            <!-- Status readout: what is playing, and how fast we are drawing -->
            <StackPanel Grid.Row="4" Margin="4,14,0,0">
                <TextBlock x:Name="AnimationStatusTextBlock"
                           Text="Manual mode"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#DDDDDD"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="EffectDescriptionTextBlock"
                           Text="Click cells to toggle bulbs by hand."
                           FontSize="13"
                           Foreground="#999999"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>

                <!--
                    Shows the real measured redraw rate. Handy for confirming the
                    simulator keeps up, and it will matter more once the wall is
                    being driven for real.
                -->
                <TextBlock x:Name="FrameRateTextBlock"
                           Text=""
                           FontSize="12"
                           Foreground="#777777"
                           Margin="0,6,0,0"/>

                <!--
                    The output pipeline readout.

                    Everything downstream of the engine reports here: how fast
                    the engine is ticking, how fast packets are going out, and
                    what the virtual wall on the other end made of them.

                    Until real hardware is attached this is the main evidence
                    that the whole chain works. "Sending 30 pkt/s" with a
                    matching count of packets accepted and no checksum failures
                    means frames are reaching a wall intact - just a simulated
                    one for now.
                -->
                <TextBlock x:Name="OutputStatusTextBlock"
                           Text="Output: starting..."
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#AAAAAA"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"/>

                <TextBlock x:Name="OutputStatsTextBlock"
                           Text=""
                           FontSize="12"
                           FontFamily="Consolas"
                           Foreground="#777777"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
