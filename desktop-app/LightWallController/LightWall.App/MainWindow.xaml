<Window x:Class="LightWall.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Light Wall Simulator"
        Height="780"
        Width="1020"
        MinHeight="650"
        MinWidth="820"
        Background="#1E1E1E">

    <!--
        Main application window for the simulator.

        This XAML file defines the visible structure/layout of the window.
        It does NOT contain the real logic of the app.
        The logic lives in MainWindow.xaml.cs.

        Beginner mental model:
        - XAML = what the UI looks like
        - .xaml.cs = what the UI does
    -->

    <Grid Margin="24">
        <!--
            Main layout grid for the whole window.

            We split the window into 5 stacked rows:
            Row 0 = title / descriptive text
            Row 1 = static pattern controls
            Row 2 = animation control buttons
            Row 3 = speed control + animation status
            Row 4 = the actual 5x7 wall simulator
        -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header area -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <!-- Main app title -->
            <TextBlock Text="Light Wall Simulator"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"/>

            <!-- Helpful subtitle for the current prototype -->
            <TextBlock Text="Click cells to toggle bulbs, test static patterns, or run animated and procedural effects."
                       FontSize="14"
                       Foreground="#CCCCCC"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Static patterns section -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Static Patterns"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,10"/>

            <WrapPanel>
                <Button Content="Clear"
                        Width="96"
                        Height="32"
                        Margin="0,0,10,10"
                        Click="ClearButton_Click"/>

                <Button Content="Fill"
                        Width="96"
                        Height="32"
                        Margin="0,0,10,10"
                        Click="FillButton_Click"/>

                <Button Content="Randomize"
                        Width="96"
                        Height="32"
                        Margin="0,0,10,10"
                        Click="RandomizeButton_Click"/>

                <Button Content="Row 3"
                        Width="96"
                        Height="32"
                        Margin="0,0,10,10"
                        Click="RowThreeButton_Click"/>

                <Button Content="Column 4"
                        Width="96"
                        Height="32"
                        Margin="0,0,10,10"
                        Click="ColumnFourButton_Click"/>

                <Button Content="Checkerboard"
                        Width="96"
                        Height="32"
                        Margin="0,0,10,10"
                        Click="CheckerboardButton_Click"/>

                <Button Content="Border"
                        Width="96"
                        Height="32"
                        Margin="0,0,10,10"
                        Click="BorderButton_Click"/>

                <Button Content="Cross"
                        Width="96"
                        Height="32"
                        Margin="0,0,10,10"
                        Click="CrossButton_Click"/>

                <Button Content="Sparkle"
                        Width="96"
                        Height="32"
                        Margin="0,0,10,10"
                        Click="SparkleButton_Click"/>
            </WrapPanel>
        </StackPanel>

        <!-- Animation sections + controls -->
        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <!-- Pre-set animations -->
            <TextBlock Text="Pre-Set Animations"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,10"/>

            <WrapPanel Margin="0,0,0,14">
                <Button Content="Start Row Sweep"
                        Width="150"
                        Height="36"
                        Margin="0,0,12,12"
                        Click="StartRowSweepButton_Click"/>

                <Button Content="Start Border Pulse"
                        Width="150"
                        Height="36"
                        Margin="0,0,12,12"
                        Click="StartBorderPulseButton_Click"/>

                <Button Content="Start Spiral"
                        Width="150"
                        Height="36"
                        Margin="0,0,12,12"
                        Click="StartSpiralButton_Click"/>
            </WrapPanel>

            <!-- Procedural animations -->
            <TextBlock Text="Procedural Animations"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,10"/>

            <WrapPanel Margin="0,0,0,14">
                <Button Content="Start Meteor"
                        Width="150"
                        Height="36"
                        Margin="0,0,12,12"
                        Click="StartMeteorButton_Click"/>

                <Button Content="Start Sparkle Storm"
                        Width="150"
                        Height="36"
                        Margin="0,0,12,12"
                        Click="StartSparkleStormButton_Click"/>

                <Button Content="Start EQ Bumper"
                        Width="150"
                        Height="36"
                        Margin="0,0,12,12"
                        Click="StartEqBumperButton_Click"/>

                <Button Content="Stop Animation"
                        Width="150"
                        Height="36"
                        Margin="0,0,12,12"
                        Click="StopAnimationButton_Click"/>
            </WrapPanel>

            <!-- Animation controls -->
            <TextBlock Text="Animation Controls"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Speed -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Speed"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="White"
                           Margin="0,0,12,10"/>

                <Slider x:Name="SpeedSlider"
                        Grid.Row="0"
                        Grid.Column="1"
                        Minimum="40"
                        Maximum="200"
                        Value="100"
                        TickFrequency="10"
                        SmallChange="5"
                        LargeChange="10"
                        VerticalAlignment="Center"
                        Margin="0,0,0,10"
                        ValueChanged="SpeedSlider_ValueChanged"/>

                <TextBlock x:Name="SpeedValueTextBlock"
                           Grid.Row="0"
                           Grid.Column="2"
                           Text="100%"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#DDDDDD"
                           Margin="12,0,0,10"/>

                <!-- Center X -->
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Center X"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="White"
                           Margin="0,0,12,10"/>

                <Slider x:Name="CenterXSlider"
                        Grid.Row="1"
                        Grid.Column="1"
                        Minimum="-2"
                        Maximum="2"
                        Value="0"
                        TickFrequency="1"
                        SmallChange="1"
                        LargeChange="1"
                        IsSnapToTickEnabled="True"
                        VerticalAlignment="Center"
                        Margin="0,0,0,10"
                        ValueChanged="CenterSlider_ValueChanged"/>

                <TextBlock x:Name="CenterXValueTextBlock"
                           Grid.Row="1"
                           Grid.Column="2"
                           Text="0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#DDDDDD"
                           Margin="12,0,0,10"/>

                <!-- Center Y -->
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Center Y"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="White"
                           Margin="0,0,12,10"/>

                <Slider x:Name="CenterYSlider"
                        Grid.Row="2"
                        Grid.Column="1"
                        Minimum="-2"
                        Maximum="2"
                        Value="0"
                        TickFrequency="1"
                        SmallChange="1"
                        LargeChange="1"
                        IsSnapToTickEnabled="True"
                        VerticalAlignment="Center"
                        Margin="0,0,0,10"
                        ValueChanged="CenterSlider_ValueChanged"/>

                <TextBlock x:Name="CenterYValueTextBlock"
                           Grid.Row="2"
                           Grid.Column="2"
                           Text="0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#DDDDDD"
                           Margin="12,0,0,10"/>

                <!-- Meteor Tail Length -->
                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Meteor Tail"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="White"/>

                <Slider x:Name="MeteorTailLengthSlider"
                        Grid.Row="3"
                        Grid.Column="1"
                        Minimum="1"
                        Maximum="5"
                        Value="3"
                        TickFrequency="1"
                        SmallChange="1"
                        LargeChange="1"
                        IsSnapToTickEnabled="True"
                        VerticalAlignment="Center"
                        ValueChanged="MeteorTailLengthSlider_ValueChanged"/>

                <TextBlock x:Name="MeteorTailLengthValueTextBlock"
                           Grid.Row="3"
                           Grid.Column="2"
                           Text="3"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#DDDDDD"
                           Margin="12,0,0,0"/>

                <!-- Animation status -->
                <TextBlock x:Name="AnimationStatusTextBlock"
                           Grid.Row="0"
                           Grid.Column="4"
                           Grid.RowSpan="4"
                           Text="Animation: stopped"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#DDDDDD"/>
            </Grid>
        </StackPanel>

        <!-- Visual simulator area -->
        <Border Grid.Row="3"
                Background="#2B2B2B"
                CornerRadius="16"
                Padding="24">
            <!--
                UniformGrid lays out all children in evenly sized cells.

                This is perfect for a 5x7 wall because the code-behind can
                dynamically add 35 buttons, and UniformGrid will automatically
                place them into 5 rows and 7 columns.
            -->
            <UniformGrid x:Name="WallGrid"
                         Rows="5"
                         Columns="7"/>
        </Border>
    </Grid>
</Window>