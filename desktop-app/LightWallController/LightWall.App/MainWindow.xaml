<Window x:Class="LightWall.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Light Wall Simulator"
        Height="820"
        Width="1240"
        MinHeight="600"
        MinWidth="900"
        Background="#1E1E1E">

    <!--
        Main application window for the simulator.

        This XAML file defines the visible structure/layout of the window.
        It does NOT contain the real logic of the app.
        The logic lives in MainWindow.xaml.cs.

        Mental model:
        - XAML     = what the UI looks like
        - .xaml.cs = what the UI does

        WHY THE LAYOUT IS TWO COLUMNS

        Everything used to be stacked vertically, with the wall at the bottom.
        The controls grew tall enough that the wall was pushed off the bottom of
        the screen entirely at any sensible window height.

        Controls on the left and the wall on the right fixes that, and is a
        better use of the space anyway: a widescreen monitor has horizontal room
        to spare and very little vertical room. It also gives the wall the
        prominence it should have, since it is the thing being looked at.

        WHY THERE ARE ALMOST NO BUTTONS WRITTEN HERE

        The effect buttons used to be listed out one by one in this file, which
        meant adding an effect required editing three places.

        The three WrapPanels below are left empty on purpose and filled in by the
        code-behind, which asks EffectCatalog what effects exist and makes a
        button for each. Adding an effect to the catalog makes it appear here
        automatically.
    -->

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <!-- Left: all the controls, in a scrollable panel. -->
            <ColumnDefinition Width="540"/>
            <!-- Right: the wall itself, taking whatever space is left. -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--
            The controls sit inside a ScrollViewer so that shrinking the window
            makes them scroll rather than getting cut off and becoming
            unreachable.
        -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,24,0">
            <StackPanel>

                <!-- Header area -->
                <TextBlock Text="Light Wall Simulator"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Click cells to toggle bulbs by hand, or choose a pattern or animation. Hover a button to see what it does."
                           FontSize="13"
                           Foreground="#CCCCCC"
                           TextWrapping="Wrap"
                           Margin="0,6,0,16"/>

                <!-- Static patterns section -->
                <TextBlock Text="Static Patterns"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,8"/>

                <!-- Filled in by BuildEffectButtons() in the code-behind. -->
                <WrapPanel x:Name="StaticPatternsPanel" Margin="0,0,0,6"/>

                <!-- Pre-set animations section -->
                <TextBlock Text="Pre-Set Animations"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,8,0,8"/>

                <!-- Filled in by BuildEffectButtons() in the code-behind. -->
                <WrapPanel x:Name="SequenceAnimationsPanel" Margin="0,0,0,6"/>

                <!-- Procedural animations section -->
                <TextBlock Text="Procedural Animations"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,8,0,8"/>

                <!-- Filled in by BuildEffectButtons() in the code-behind. -->
                <WrapPanel x:Name="ProceduralAnimationsPanel" Margin="0,0,0,6"/>

                <!--
                    Stop is written out by hand rather than generated, because it
                    is not an effect. It switches the engine into manual mode,
                    leaving whatever frame was showing frozen on the wall.
                -->
                <Button Content="Stop Animation"
                        Width="150"
                        Height="34"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,14"
                        ToolTip="Stops the running effect and freezes the wall on its current frame."
                        Click="StopAnimationButton_Click"/>

                <!-- Animation controls -->
                <TextBlock Text="Animation Controls"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <!-- Speed -->
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Speed"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,0,12,10"/>

                    <Slider x:Name="SpeedSlider"
                            Grid.Row="0"
                            Grid.Column="1"
                            Minimum="10"
                            Maximum="300"
                            Value="100"
                            TickFrequency="10"
                            SmallChange="5"
                            LargeChange="10"
                            VerticalAlignment="Center"
                            Margin="0,0,0,10"
                            ToolTip="How fast effects play. 100% is their designed speed."
                            ValueChanged="SpeedSlider_ValueChanged"/>

                    <TextBlock x:Name="SpeedValueTextBlock"
                               Grid.Row="0"
                               Grid.Column="2"
                               Text="100%"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#DDDDDD"
                               Margin="12,0,0,10"/>

                    <!-- Center X -->
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Center X"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,0,12,10"/>

                    <Slider x:Name="CenterXSlider"
                            Grid.Row="1"
                            Grid.Column="1"
                            Minimum="-3"
                            Maximum="3"
                            Value="0"
                            TickFrequency="1"
                            SmallChange="1"
                            LargeChange="1"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            Margin="0,0,0,10"
                            ToolTip="Shifts the picture left or right. Content pushed off the edge is discarded."
                            ValueChanged="CenterSlider_ValueChanged"/>

                    <TextBlock x:Name="CenterXValueTextBlock"
                               Grid.Row="1"
                               Grid.Column="2"
                               Text="0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#DDDDDD"
                               Margin="12,0,0,10"/>

                    <!-- Center Y -->
                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Center Y"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,0,12,10"/>

                    <Slider x:Name="CenterYSlider"
                            Grid.Row="2"
                            Grid.Column="1"
                            Minimum="-2"
                            Maximum="2"
                            Value="0"
                            TickFrequency="1"
                            SmallChange="1"
                            LargeChange="1"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            Margin="0,0,0,10"
                            ToolTip="Shifts the picture up or down. Content pushed off the edge is discarded."
                            ValueChanged="CenterSlider_ValueChanged"/>

                    <TextBlock x:Name="CenterYValueTextBlock"
                               Grid.Row="2"
                               Grid.Column="2"
                               Text="0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#DDDDDD"
                               Margin="12,0,0,10"/>

                    <!-- Meteor Tail Length -->
                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="Meteor Tail"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,0,12,0"/>

                    <Slider x:Name="MeteorTailLengthSlider"
                            Grid.Row="3"
                            Grid.Column="1"
                            Minimum="1"
                            Maximum="5"
                            Value="3"
                            TickFrequency="1"
                            SmallChange="1"
                            LargeChange="1"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ToolTip="How long the Meteor effect's trail is. Only affects Meteor."
                            ValueChanged="MeteorTailLengthSlider_ValueChanged"/>

                    <TextBlock x:Name="MeteorTailLengthValueTextBlock"
                               Grid.Row="3"
                               Grid.Column="2"
                               Text="3"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#DDDDDD"
                               Margin="12,0,0,0"/>
                </Grid>

                <!--
                    Hardware check.

                    Lights one bulb at a time so the wiring can be confirmed
                    against the relay labels in the enclosure.

                    This answers the one question that cannot be settled at a
                    desk: whether relay A1 really does switch the top-left bulb.
                    The app and the firmware will agree perfectly with each other
                    while both being wrong about the physical wall, and only
                    looking at it can tell.

                    Stepping is manual on purpose. An automatic sweep would move
                    on while you were still walking round to look at the wall.
                -->
                <TextBlock Text="Hardware Check"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,4"/>

                <TextBlock Text="Lights one bulb at a time, so the wiring can be checked against the relay labels."
                           FontSize="12"
                           Foreground="#999999"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <!--
                    The readout naming the current bulb every way at once: its
                    number, its position, the sticker on its relay, and the
                    Arduino pin. Having all four visible means a reading can be
                    checked against the wall and against the relay that just
                    clicked without doing arithmetic on a ladder.
                -->
                <Border Background="#232323"
                        BorderBrush="#444444"
                        BorderThickness="1"
                        Padding="10,8"
                        Margin="0,0,0,10">
                    <TextBlock x:Name="IdentifyReadoutTextBlock"
                               Text="Not running"
                               FontFamily="Consolas"
                               FontSize="13"
                               Foreground="#FFC700"
                               TextWrapping="Wrap"/>
                </Border>

                <WrapPanel Margin="0,0,0,10">
                    <Button Content="Start Check"
                            Width="110"
                            Height="32"
                            Margin="0,0,10,8"
                            ToolTip="Lights a single bulb and holds it, so the wiring can be checked."
                            Click="IdentifyStartButton_Click"/>

                    <Button Content="◀ Previous"
                            Width="100"
                            Height="32"
                            Margin="0,0,10,8"
                            ToolTip="Step back one bulb."
                            Click="IdentifyPreviousButton_Click"/>

                    <Button Content="Next ▶"
                            Width="100"
                            Height="32"
                            Margin="0,0,10,8"
                            ToolTip="Step forward one bulb."
                            Click="IdentifyNextButton_Click"/>
                </WrapPanel>

                <!--
                    Jumping straight to a relay label. Faster than stepping
                    through 35 when spot-checking a single suspicious bulb, and
                    it lets you work from the sticker rather than from a number.
                -->
                <WrapPanel Margin="0,0,0,16">
                    <TextBlock Text="Go to relay"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,0,10,0"/>

                    <TextBox x:Name="IdentifyLabelTextBox"
                             Width="70"
                             Height="28"
                             VerticalContentAlignment="Center"
                             Padding="6,0"
                             Background="#232323"
                             Foreground="#DDDDDD"
                             BorderBrush="#444444"
                             FontFamily="Consolas"
                             ToolTip="Type a relay label such as C4, then press Enter or Go."
                             KeyDown="IdentifyLabelTextBox_KeyDown"/>

                    <Button Content="Go"
                            Width="60"
                            Height="28"
                            Margin="10,0,0,0"
                            Click="IdentifyGoButton_Click"/>
                </WrapPanel>

                <!--
                    Fault injection.

                    These deliberately damage the byte stream on its way to the
                    virtual wall, imitating a noisy or failing cable.

                    This is not a toy. A real cable will occasionally lose or
                    mangle a byte, and the question that matters is not whether
                    that happens but whether everything downstream recovers when
                    it does. Making a real cable misbehave on demand is very
                    difficult. Here it is a slider.

                    Turn either up and watch the bottom wall start lagging behind
                    the top one as damaged packets are thrown away, then catch
                    up. The statistics underneath it count what happened.
                -->
                <TextBlock Text="Virtual Wall Faults"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,4"/>

                <TextBlock Text="Damages the byte stream on purpose, to prove the receiver recovers."
                           FontSize="12"
                           Foreground="#999999"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Drop bytes"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,0,12,10"/>

                    <Slider x:Name="ByteDropSlider"
                            Grid.Row="0"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="5"
                            Value="0"
                            TickFrequency="0.5"
                            SmallChange="0.1"
                            LargeChange="0.5"
                            VerticalAlignment="Center"
                            Margin="0,0,0,10"
                            ToolTip="Chance of each byte vanishing. The nastiest fault, because it shifts everything after it out of position."
                            ValueChanged="FaultSlider_ValueChanged"/>

                    <TextBlock x:Name="ByteDropValueTextBlock"
                               Grid.Row="0"
                               Grid.Column="2"
                               Text="0.0%"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#DDDDDD"
                               Margin="12,0,0,10"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Corrupt bytes"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="White"
                               Margin="0,0,12,0"/>

                    <Slider x:Name="ByteCorruptSlider"
                            Grid.Row="1"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="5"
                            Value="0"
                            TickFrequency="0.5"
                            SmallChange="0.1"
                            LargeChange="0.5"
                            VerticalAlignment="Center"
                            ToolTip="Chance of each byte arriving with one bit flipped. The checksum should catch these."
                            ValueChanged="FaultSlider_ValueChanged"/>

                    <TextBlock x:Name="ByteCorruptValueTextBlock"
                               Grid.Row="1"
                               Grid.Column="2"
                               Text="0.0%"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#DDDDDD"
                               Margin="12,0,0,0"/>
                </Grid>

                <!-- Serialized packet preview -->
                <TextBlock Text="Packet Preview"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,8"/>

                <!--
                    Read-only preview of the bytes that would go down the serial
                    cable for the frame currently on screen.

                    This is a development aid. It lets us confirm the wall state
                    is being packed as expected before any real hardware is
                    involved, and it will be the first thing to check when the
                    wall eventually shows something unexpected.
                -->
                <TextBox x:Name="SerializedPacketTextBox"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         MinHeight="60"
                         Padding="8"
                         Background="#232323"
                         Foreground="#DDDDDD"
                         BorderBrush="#444444"
                         FontFamily="Consolas"
                         FontSize="12"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Visual simulator area -->
        <Grid Grid.Column="1">
            <!--
                TWO WALLS, ONE ABOVE THE OTHER

                Top    - what the engine decided the wall should look like.
                Bottom - what a wall on the other end of the cable would
                         actually be showing, decoded from the packets we sent.

                In normal running these are identical, and that is the point:
                seeing them match while sliders are being dragged is the proof
                that the whole chain works - packing, transmission, framing,
                checksum validation and unpacking.

                They come apart when something goes wrong. Turn up the fault
                sliders and the bottom wall starts freezing on old frames as
                packets get thrown away, then catches up again. That is the real
                error handling being exercised, not a mock-up of it.
            -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Engine — what the wall should show"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="#AAAAAA"
                       Margin="4,0,0,6"/>

            <Border Grid.Row="1"
                    Background="#2B2B2B"
                    CornerRadius="16"
                    Padding="14">
                <!--
                    Viewbox scales whatever is inside it to fit the space while
                    keeping its proportions.

                    That is what keeps the wall looking like a 7-wide, 5-tall
                    wall at any window size. Without it, the grid would stretch
                    to fill whatever shape the window happened to be, and the
                    bulbs would become tall thin rectangles on a narrow window -
                    a misleading picture of a physical object we are trying to
                    represent faithfully.

                    The 700 x 500 size below is only a ratio. The Viewbox scales
                    it up or down to whatever actually fits.
                -->
                <Viewbox Stretch="Uniform">
                    <UniformGrid x:Name="WallGrid"
                                 Rows="5"
                                 Columns="7"
                                 Width="700"
                                 Height="500"/>
                </Viewbox>
            </Border>

            <TextBlock Grid.Row="2"
                       Text="Virtual wall — decoded from the packets sent"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="#AAAAAA"
                       Margin="4,14,0,6"/>

            <Border Grid.Row="3"
                    Background="#242424"
                    CornerRadius="16"
                    Padding="14">
                <Viewbox Stretch="Uniform">
                    <UniformGrid x:Name="VirtualWallGrid"
                                 Rows="5"
                                 Columns="7"
                                 Width="700"
                                 Height="500"/>
                </Viewbox>
            </Border>

            <!-- Status readout: what is playing, and how fast we are drawing -->
            <StackPanel Grid.Row="4" Margin="4,14,0,0">
                <TextBlock x:Name="AnimationStatusTextBlock"
                           Text="Manual mode"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#DDDDDD"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="EffectDescriptionTextBlock"
                           Text="Click cells to toggle bulbs by hand."
                           FontSize="13"
                           Foreground="#999999"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>

                <!--
                    Shows the real measured redraw rate. Handy for confirming the
                    simulator keeps up, and it will matter more once the wall is
                    being driven for real.
                -->
                <TextBlock x:Name="FrameRateTextBlock"
                           Text=""
                           FontSize="12"
                           Foreground="#777777"
                           Margin="0,6,0,0"/>

                <!--
                    The output pipeline readout.

                    Everything downstream of the engine reports here: how fast
                    the engine is ticking, how fast packets are going out, and
                    what the virtual wall on the other end made of them.

                    Until real hardware is attached this is the main evidence
                    that the whole chain works. "Sending 30 pkt/s" with a
                    matching count of packets accepted and no checksum failures
                    means frames are reaching a wall intact - just a simulated
                    one for now.
                -->
                <TextBlock x:Name="OutputStatusTextBlock"
                           Text="Output: starting..."
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#AAAAAA"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"/>

                <TextBlock x:Name="OutputStatsTextBlock"
                           Text=""
                           FontSize="12"
                           FontFamily="Consolas"
                           Foreground="#777777"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
