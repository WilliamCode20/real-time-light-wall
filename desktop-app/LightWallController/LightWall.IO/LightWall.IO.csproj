<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LightWall.IO

    Talking to the outside world: serial communication with the Arduino, and
    later Windows system audio capture.

    Shared settings (ImplicitUsings, Nullable) come from Directory.Build.props
    in the parent folder.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Serial port support is not part of the base .NET runtime - it lives in a
      separate package, because most programs never need it.
    -->
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LightWall.Core\LightWall.Core.csproj" />
  </ItemGroup>

</Project>
