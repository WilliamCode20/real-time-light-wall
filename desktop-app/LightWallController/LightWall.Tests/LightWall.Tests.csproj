<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LightWall.Tests

    Automated tests for LightWall.Core.

    Why tests matter for this project specifically:
    Soon the app will be sending data down a wire to a physical wall. When
    something looks wrong on the wall, the first question is always
    "is the app wrong, or is the wiring wrong?"

    These tests answer the first half of that question instantly, so debugging
    can focus on the hardware.

    Run them with:
      dotnet test

    Shared settings (ImplicitUsings, Nullable) come from Directory.Build.props
    in the parent folder.
  -->

  <PropertyGroup>
    <!--
      Targets net10.0-windows only because it references LightWall.IO, which
      became Windows-specific when audio capture arrived. A project can only
      reference something at least as platform-specific as itself.

      The tests themselves are almost entirely about LightWall.Core, which is
      still plain net10.0 and knows nothing about Windows.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>

    <!-- This project is a test harness, never something we ship or package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LightWall.Core\LightWall.Core.csproj" />
    <ProjectReference Include="..\LightWall.IO\LightWall.IO.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Makes "Xunit" available in every test file without an explicit using. -->
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
